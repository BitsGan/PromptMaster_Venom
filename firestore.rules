rules_version = '2';
service cloudfirestore {
  match /databases/{database}/documents {

    // Helper Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Context-sensitive getters (Only use inside write blocks!)
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User Profile Validation Helpers (No DB reads, strict static validation)
    function isValidUserProfile(data) {
      return data.uid is string && data.uid.size() <= 128 && data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 256 &&
             data.displayName is string && data.displayName.size() <= 256 &&
             data.photoURL is string && data.photoURL.size() <= 2048 &&
             data.completedLevels is list && data.completedLevels.size() <= 100 &&
             data.timeTrialSuccesses is list && data.timeTrialSuccesses.size() <= 100 &&
             data.totalScore is int && data.totalScore >= 0 && data.totalScore <= 10000 &&
             data.highScores is map &&
             data.timeTrialBestTimes is map &&
             (!('completedDailyChallenges' in data) || data.completedDailyChallenges is list) &&
             (!('dailyHighScores' in data) || data.dailyHighScores is map) &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    function isValidSolution(data) {
      return data.levelId is int && data.levelId >= 0 && data.levelId <= 1000 &&
             data.levelTitle is string && data.levelTitle.size() <= 256 &&
             data.prompt is string && data.prompt.size() <= 5000 &&
             data.score is int && data.score >= 0 && data.score <= 100 &&
             data.submittedAt is timestamp;
    }

    function isValidDailyChallenge(data) {
      return data.id is int && data.id >= 100 &&
             data.title is string && data.title.size() <= 256 &&
             data.difficulty is string && data.difficulty.size() <= 64 &&
             data.targetKeywords is list && data.targetKeywords.size() <= 20 &&
             data.hints is string && data.hints.size() <= 1024 &&
             data.description is string && data.description.size() <= 2048 &&
             data.proceduralTheme is string && data.proceduralTheme.size() <= 128 &&
             data.dateStr is string && data.dateStr.size() <= 32;
    }

    // Rule matchers for users and solutions
    match /users/{userId} {
      // 3. Path Variable Hardening (ID poisoning guard) & no blanket reads
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false; // Strict prohibition on listing the users collection

      allow create: if isOwner(userId) && isValidId(userId) && 
                      isValidUserProfile(incoming()) &&
                      incoming().createdAt == request.time &&
                      incoming().updatedAt == request.time;

      // 5. Action-Based Update Pattern using Map diff affectedKeys
      allow update: if isOwner(userId) && isValidId(userId) && 
                      isValidUserProfile(incoming()) &&
                      incoming().updatedAt == request.time &&
                      incoming().createdAt == existing().createdAt &&
                      incoming().uid == existing().uid &&
                      incoming().email == existing().email && (
                        // Case A: Sync Stats
                        incoming().diff(existing()).affectedKeys().hasOnly([
                          'completedLevels', 'totalScore', 'highScores', 'timeTrialBestTimes', 'timeTrialSuccesses', 'completedDailyChallenges', 'dailyHighScores', 'updatedAt'
                        ]) ||
                        // Case B: Update display properties
                        incoming().diff(existing()).affectedKeys().hasOnly([
                          'displayName', 'photoURL', 'updatedAt'
                        ])
                      );

      allow delete: if false; // Deletion of user profile is prohibited to maintain stats records integrity

      // Solutions Sub-collection containing user successful matching records
      match /solutions/{solutionId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(solutionId);
        allow list: if isOwner(userId) && isValidId(userId);

        allow create: if isOwner(userId) && isValidId(userId) && isValidId(solutionId) &&
                        isValidSolution(incoming()) &&
                        incoming().submittedAt == request.time;

        // Solution entries once written are immutable (no hacking score records)
        allow update, delete: if false;
      }
    }

    match /dailyChallenges/{challengeId} {
      allow read: if true;
      allow create, update: if isSignedIn() && isValidId(challengeId) && isValidDailyChallenge(incoming());
      allow delete: if false;
    }

    match /test/{documentId} {
      allow read, write: if true;
    }
  }
}
